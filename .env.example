# ==============================================================================
# Environment Configuration - Customer Journey Analytics API
# ==============================================================================
# Salin file ini menjadi .env sebelum menjalankan aplikasi:
#   cp .env.example .env
# JANGAN PERNAH menyimpan credential atau private key asli di file ini / git repository.
# ==============================================================================

# Mode Environment: development, staging, production
ENVIRONMENT=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Metadata API
API_TITLE=Customer Journey Analytics API
API_VERSION=1.0.0
API_PREFIX=/api/v1

# Keamanan REST API
# Pada production, ganti API_KEY ini dengan nilai rahasia (contoh: openssl rand -hex 32)
API_KEY=development-secret-key-change-in-production
API_KEY_NAME=X-API-Key

# Cross-Origin Resource Sharing (CORS)
# Pisahkan dengan koma. Pada production, hanya masukkan domain frontend terdaftar.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# Konfigurasi Google Cloud BigQuery
# ==============================================================================
GCP_PROJECT_ID=rangkul-355bb
BQ_DATASET=analytics_journey

# Path absolut ke file JSON Service Account pada server Linux.
# Kosongkan jika menggunakan Google Application Default Credentials (ADC).
GOOGLE_APPLICATION_CREDENTIALS=/opt/customer-journey-api/credentials/service-account.json

# Nama tabel lengkap BigQuery (Format: project_id.dataset_id.table_name)
BQ_EVENTS_TABLE=rangkul-355bb.analytics_journey.raw_events_agustus_september
BQ_CUSTOMERS_TABLE=rangkul-355bb.analytics_journey.all_customer_rangkul

# Proteksi Biaya & Performa BigQuery
# Batas maksimum byte yang ditagihkan per query (10737418240 bytes = 10 GB).
# Kosongkan jika tidak ingin membatasi.
BQ_MAX_BYTES_BILLED=10737418240

# Query timeout dalam detik
BQ_QUERY_TIMEOUT_SECONDS=60

# ==============================================================================
# Konfigurasi Pagination
# ==============================================================================
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
